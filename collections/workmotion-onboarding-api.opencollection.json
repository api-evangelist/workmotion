            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiates an accelerated onboarding for a new hire in a given country."
        },
        {
          "info": {
            "name": "Retrieve onboarding status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.workmotion.com/v1/onboardings/:onboardingId",
            "params": [
              {
                "name": "onboardingId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve onboarding status"
        }
      ]
    }
  ],
  "bundled": true
}