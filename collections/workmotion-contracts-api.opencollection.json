{
  "opencollection": "1.0.0",
  "info": {
    "name": "WorkMotion Partner Absences Contracts API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contracts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List contracts for an employee",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.workmotion.com/v1/employees/:employeeId/contracts",
            "params": [
              {
                "name": "employeeId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List contracts for an employee"
        },
        {
          "info": {
            "name": "Generate a contract for an employee",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.workmotion.com/v1/employees/:employeeId/contracts",
            "params": [
              {
                "name": "employeeId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates a legally compliant employment contract for the talent."
        },
        {
          "info": {
            "name": "Retrieve a contract",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.workmotion.com/v1/contracts/:contractId",
            "params": [
              {
                "name": "contractId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a contract"
        },
        {
          "info": {
            "name": "Amend a contract",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.workmotion.com/v1/contracts/:contractId",
            "params": [
              {
                "name": "contractId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Applies a contract change (e.g., compensation or terms) to an existing contract."
        }
      ]
    }
  ],
  "bundled": true
}